{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Market Connector",
            "type": "debugpy",
            "request": "launch",
            "module": "app.market_connector",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Custom Debug",
            "type": "debugpy",
